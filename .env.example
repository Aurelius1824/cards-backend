# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB
#   Local development (Docker Compose): mongodb://mongodb:27017/CardsDB
#   Production (MongoDB Atlas): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/CardsDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/CardsDB

# Port for the Node API server
PORT=5000

# Secret used to sign login tokens. Use a long random value, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=25b46d4e65be93f21a187b1be75180d7d54b79123b7065a7e5afe16f3424849be9ba6b623bf46e93edcfb4a0e7f3b184

# How long a login lasts (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
